{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nEvery entry here is generated by semantic-release from the conventional commits on `main`. Do not edit by hand."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "scripts/release_plan.sh ${nextRelease.version}",
        "prepareCmd": "scripts/set_version.sh ${nextRelease.version}",
        "successCmd": "scripts/release_outputs.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "app/build.gradle.kts",
          "README.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successCommentCondition": false,
        "failCommentCondition": false
      }
    ]
  ]
}
