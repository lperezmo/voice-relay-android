<?xml version="1.0" encoding="utf-8"?>
<!-- The "Glyph" launcher icon (the .glyph.CanvasLauncher alias): the gold spiral mark from the
     Glyph app on its slate tile. Shown only while the built-in canvas is on. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/glyph_ic_launcher_background" />
    <foreground android:drawable="@drawable/glyph_ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/glyph_ic_launcher_monochrome" />
</adaptive-icon>
