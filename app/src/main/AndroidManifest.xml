<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Volume presets: DND on and off, and the ringer in and out of silent. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Ends the Silent + DND hour on time. Optional: without it, up to 10 minutes late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Wake word: an always-on microphone foreground service with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wake word: "Display over other apps" lets it open Claude from the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Wake word: open Claude's assistant with ACTION_VOICE_ASSIST (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VOICE_ASSIST" />
        </intent>
        <!-- Glyph pill: is Glyph installed, and does it answer OPEN_CANVAS. -->
        <package android:name="com.lperezmo.glyph" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceRelay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings > About > Open-source licenses. -->
        <activity
            android:name=".LicensesActivity"
            android:exported="false" />

        <!-- "Fix grammar" in every app's text-selection menu. -->
        <activity
            android:name=".FixGrammarActivity"
            android:exported="true"
            android:label="@string/fix_grammar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.VoiceRelay.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Sends the joystick's arrow keys; a keyboard is the only way an app
             may deliver key events to another app. It shows no keys of its own. -->
        <service
            android:name=".KeysInputMethodService"
            android:label="@string/keys_ime_label"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Wake word: listens for the wake phrase ("hey claude" by default) and opens Claude's voice assistant. -->
        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Wake word on/off for Tasker and adb. Invisible; see WakeControlActivity. -->
        <activity
            android:name=".WakeControlActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.VoiceRelay.Invisible">
            <intent-filter>
                <action android:name="com.lperezmo.voicerelay.WAKE_ON" />
                <action android:name="com.lperezmo.voicerelay.WAKE_OFF" />
                <action android:name="com.lperezmo.voicerelay.CLAUDE_VOICE" />
                <action android:name="com.lperezmo.voicerelay.WAKE_TOGGLE" />
                <action android:name="com.lperezmo.voicerelay.BUTTONS_HIDE" />
                <action android:name="com.lperezmo.voicerelay.BUTTONS_SHOW" />
                <action android:name="com.lperezmo.voicerelay.BUTTONS_TOGGLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile: hide or show every floating button, e.g. to record the screen. -->
        <service
            android:name=".ButtonsTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/buttons_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name=".DndExpiryReceiver"
            android:exported="false" />

        <service
            android:name=".WhisperAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
